{
  "name": "discogs-vinyl-sorter-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:lan": "expo start --dev-client --lan",
    "start:tunnel": "expo start --dev-client --tunnel",
    "start:clear": "expo start --dev-client --clear",
    "postinstall": "node scripts/fix-nested-deps.js",
    "eas-build-pre-install": "node scripts/eas-write-env.js",
    "android": "node scripts/run-android.js",
    "android:device": "node scripts/run-android.js --device-only",
    "android:emulator": "node scripts/start-emulator.js",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "update:preview": "eas update --channel preview --non-interactive --auto",
    "update:production": "eas update --channel production --non-interactive --auto"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
