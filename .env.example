# Discogs OAuth – copy to .env and fill in your values.
# Never commit .env to version control.
#
# 1. Create an app at: Discogs → Settings → Developers → Create Application
# 2. Add this Callback URL when editing your app: discogvinylsorter://callback
# 3. Copy the consumer key and secret below.

DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Optional: same HMAC secret as Windows for Pro keys (VSS1-…).
# Leave empty in production unless baked via EAS; __DEV__ uses a local default.
# VSS_LICENSE_SECRET=
# SPINDLE_DEV_PRO=1
